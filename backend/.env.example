# Application Configuration
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:3000,http://127.0.0.1:3000

# Database (MongoDB connection string - Atlas or Local)
# If left empty or unreachable, the system gracefully operates in offline local-state mode
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=docuforensics

# Storage
STORAGE_MODE=local
LOCAL_STORAGE_PATH=./storage

# OCR Configuration
OCR_ENGINE=tesseract
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional LLM Grounding (Default is "none" - works completely offline without API keys)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Security and Upload Limits
MAX_UPLOAD_MB=25
MAX_DOCUMENTS_PER_INVESTIGATION=10
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg

